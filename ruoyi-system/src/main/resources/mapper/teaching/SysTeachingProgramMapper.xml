<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.teaching.SysTeachingProgramMapper">
    <resultMap type="SysTeachingProgram" id="SysTeachingProgramResult">
        <id     property="programId"          column="program_id"          />
        <result property="majorName"          column="major_name"          />
        <result property="educationSystem"    column="education_system"    />
        <result property="trainingGoal"       column="training_goal"       />
        <result property="coreCourses"        column="core_courses"        />
        <result property="courseCredits"      column="course_credits"      />
        <result property="creditRequirement"  column="credit_requirement"  />
        <result property="graduationRequirement" column="graduation_requirement" />
        <result property="version"            column="version"            />
        <result property="status"             column="status"             />
        <result property="createBy"           column="create_by"           />
        <result property="createTime"         column="create_time"         />
        <result property="updateBy"           column="update_by"           />
        <result property="updateTime"         column="update_time"         />
        <result property="remark"             column="remark"             />
    </resultMap>

    <sql id="selectSysTeachingProgramVo">
        select program_id, major_name, education_system, training_goal, core_courses, course_credits, credit_requirement, graduation_requirement, version, status, create_by, create_time, update_by, update_time, remark from sys_teaching_program
    </sql>

    <select id="selectSysTeachingProgramByProgramId" parameterType="Long" resultMap="SysTeachingProgramResult">
        <include refid="selectSysTeachingProgramVo" />
        where program_id = #{programId}
    </select>

    <select id="selectSysTeachingProgramList" parameterType="SysTeachingProgram" resultMap="SysTeachingProgramResult">
        <include refid="selectSysTeachingProgramVo" />
        <where>
            <if test="majorName != null and majorName != ''">
                AND major_name like concat('%', #{majorName}, '%')
            </if>
            <if test="educationSystem != null and educationSystem != ''">
                AND education_system = #{educationSystem}
            </if>
            <if test="version != null and version != ''">
                AND version = #{version}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <insert id="insertSysTeachingProgram" parameterType="SysTeachingProgram" useGeneratedKeys="true" keyProperty="programId">
        insert into sys_teaching_program
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="majorName != null">major_name,</if>
            <if test="educationSystem != null">education_system,</if>
            <if test="trainingGoal != null">training_goal,</if>
            <if test="coreCourses != null">core_courses,</if>
            <if test="courseCredits != null">course_credits,</if>
            <if test="creditRequirement != null">credit_requirement,</if>
            <if test="graduationRequirement != null">graduation_requirement,</if>
            <if test="version != null">version,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="majorName != null">#{majorName},</if>
            <if test="educationSystem != null">#{educationSystem},</if>
            <if test="trainingGoal != null">#{trainingGoal},</if>
            <if test="coreCourses != null">#{coreCourses},</if>
            <if test="courseCredits != null">#{courseCredits},</if>
            <if test="creditRequirement != null">#{creditRequirement},</if>
            <if test="graduationRequirement != null">#{graduationRequirement},</if>
            <if test="version != null">#{version},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysTeachingProgram" parameterType="SysTeachingProgram">
        update sys_teaching_program
        <set>
            <if test="majorName != null">major_name = #{majorName},</if>
            <if test="educationSystem != null">education_system = #{educationSystem},</if>
            <if test="trainingGoal != null">training_goal = #{trainingGoal},</if>
            <if test="coreCourses != null">core_courses = #{coreCourses},</if>
            <if test="courseCredits != null">course_credits = #{courseCredits},</if>
            <if test="creditRequirement != null">credit_requirement = #{creditRequirement},</if>
            <if test="graduationRequirement != null">graduation_requirement = #{graduationRequirement},</if>
            <if test="version != null">version = #{version},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where program_id = #{programId}
    </update>

    <delete id="deleteSysTeachingProgramByProgramId" parameterType="Long">
        delete from sys_teaching_program where program_id = #{programId}
    </delete>

    <delete id="deleteSysTeachingProgramByProgramIds" parameterType="Long[]">
        delete from sys_teaching_program where program_id in 
        <foreach item="programId" collection="array" open="(" separator="," close=")">
            #{programId}
        </foreach>
    </delete>
</mapper>
