<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysStudentAcademicMapper">

    <resultMap type="SysStudentAcademic" id="SysStudentAcademicResult">
        <id     property="academicId"      column="academic_id"      />
        <result property="studentId"       column="student_id"       />
        <result property="studentName"     column="student_name"     />
        <result property="semester"        column="semester"        />
        <result property="courseName"      column="course_name"      />
        <result property="courseScore"     column="course_score"     />
        <result property="obtainedCredits" column="obtained_credits" />
        <result property="totalCredits"    column="total_credits"    />
        <result property="majorRank"       column="major_rank"       />
        <result property="majorName"       column="major_name"       />
        <result property="className"       column="class_name"       />
        <result property="academicStatus"  column="academic_status"  />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"          />
    </resultMap>

    <sql id="selectAcademicVo">
        select academic_id, student_id, student_name, semester, course_name, course_score, obtained_credits, total_credits, major_rank, major_name, class_name, academic_status, create_by, create_time, update_by, update_time, remark
        from sys_student_academic
    </sql>

    <select id="selectAcademicList" parameterType="SysStudentAcademic" resultMap="SysStudentAcademicResult">
        <include refid="selectAcademicVo"/>
        where 1=1
        <if test="academicId != null and academicId != 0">
            AND academic_id = #{academicId}
        </if>
        <if test="studentId != null and studentId != ''">
            AND student_id like concat('%', #{studentId}, '%')
        </if>
        <if test="studentName != null and studentName != ''">
            AND student_name like concat('%', #{studentName}, '%')
        </if>
        <if test="semester != null and semester != ''">
            AND semester = #{semester}
        </if>
        <if test="courseName != null and courseName != ''">
            AND course_name like concat('%', #{courseName}, '%')
        </if>
        <if test="majorName != null and majorName != ''">
            AND major_name like concat('%', #{majorName}, '%')
        </if>
        <if test="className != null and className != ''">
            AND class_name like concat('%', #{className}, '%')
        </if>
        <if test="academicStatus != null and academicStatus != ''">
            AND academic_status = #{academicStatus}
        </if>
        <if test="params.beginTime != null and params.beginTime != ''">
            AND date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
        </if>
        <if test="params.endTime != null and params.endTime != ''">
            AND date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
        </if>
    </select>

    <select id="selectAcademicById" parameterType="Long" resultMap="SysStudentAcademicResult">
        <include refid="selectAcademicVo"/>
        where academic_id = #{academicId}
    </select>

    <select id="selectAcademicByStudentId" parameterType="String" resultMap="SysStudentAcademicResult">
        <include refid="selectAcademicVo"/>
        where student_id = #{studentId}
    </select>

    <insert id="insertAcademic" parameterType="SysStudentAcademic" useGeneratedKeys="true" keyProperty="academicId">
        insert into sys_student_academic(
            <if test="studentId != null and studentId != ''">student_id,</if>
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="semester != null and semester != ''">semester,</if>
            <if test="courseName != null and courseName != ''">course_name,</if>
            <if test="courseScore != null">course_score,</if>
            <if test="obtainedCredits != null">obtained_credits,</if>
            <if test="totalCredits != null">total_credits,</if>
            <if test="majorRank != null">major_rank,</if>
            <if test="majorName != null and majorName != ''">major_name,</if>
            <if test="className != null and className != ''">class_name,</if>
            <if test="academicStatus != null and academicStatus != ''">academic_status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="studentId != null and studentId != ''">#{studentId},</if>
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="semester != null and semester != ''">#{semester},</if>
            <if test="courseName != null and courseName != ''">#{courseName},</if>
            <if test="courseScore != null">#{courseScore},</if>
            <if test="obtainedCredits != null">#{obtainedCredits},</if>
            <if test="totalCredits != null">#{totalCredits},</if>
            <if test="majorRank != null">#{majorRank},</if>
            <if test="majorName != null and majorName != ''">#{majorName},</if>
            <if test="className != null and className != ''">#{className},</if>
            <if test="academicStatus != null and academicStatus != ''">#{academicStatus},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateAcademic" parameterType="SysStudentAcademic">
        update sys_student_academic
        <set>
            <if test="studentId != null and studentId != ''">student_id = #{studentId},</if>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="semester != null and semester != ''">semester = #{semester},</if>
            <if test="courseName != null and courseName != ''">course_name = #{courseName},</if>
            <if test="courseScore != null">course_score = #{courseScore},</if>
            <if test="obtainedCredits != null">obtained_credits = #{obtainedCredits},</if>
            <if test="totalCredits != null">total_credits = #{totalCredits},</if>
            <if test="majorRank != null">major_rank = #{majorRank},</if>
            <if test="majorName != null and majorName != ''">major_name = #{majorName},</if>
            <if test="className != null and className != ''">class_name = #{className},</if>
            <if test="academicStatus != null and academicStatus != ''">academic_status = #{academicStatus},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where academic_id = #{academicId}
    </update>

    <delete id="deleteAcademicById" parameterType="Long">
        delete from sys_student_academic where academic_id = #{academicId}
    </delete>

    <delete id="deleteAcademicByIds" parameterType="Long">
        delete from sys_student_academic where academic_id in
        <foreach collection="array" item="academicId" open="(" separator="," close=")">
            #{academicId}
        </foreach>
    </delete>

</mapper>
