<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.research.SysResearchProjectMapper">
    <resultMap type="SysResearchProject" id="SysResearchProjectResult">
        <id     property="projectId"      column="project_id"      />
        <result property="projectName"    column="project_name"    />
        <result property="projectLeader"  column="project_leader"  />
        <result property="projectType"    column="project_type"    />
        <result property="approveTime"    column="approve_time"    />
        <result property="fundingAmount"  column="funding_amount"  />
        <result property="arrivalStatus"  column="arrival_status"  />
        <result property="attachmentUrl"  column="attachment_url"  />
        <result property="status"         column="status"         />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"         />
    </resultMap>

    <sql id="selectSysResearchProjectVo">
        select project_id, project_name, project_leader, project_type, approve_time, funding_amount, arrival_status, attachment_url, status, create_by, create_time, update_by, update_time, remark from sys_research_project
    </sql>

    <select id="selectSysResearchProjectByProjectId" parameterType="Long" resultMap="SysResearchProjectResult">
        <include refid="selectSysResearchProjectVo" />
        where project_id = #{projectId}
    </select>

    <select id="selectSysResearchProjectList" parameterType="SysResearchProject" resultMap="SysResearchProjectResult">
        <include refid="selectSysResearchProjectVo" />
        <where>
            <if test="projectName != null and projectName != ''">
                AND project_name like concat('%', #{projectName}, '%')
            </if>
            <if test="projectLeader != null and projectLeader != ''">
                AND project_leader like concat('%', #{projectLeader}, '%')
            </if>
            <if test="projectType != null and projectType != ''">
                AND project_type = #{projectType}
            </if>
            <if test="approveTime != null">
                AND approve_time = #{approveTime}
            </if>
            <if test="fundingAmount != null">
                AND funding_amount = #{fundingAmount}
            </if>
            <if test="arrivalStatus != null and arrivalStatus != ''">
                AND arrival_status = #{arrivalStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <insert id="insertSysResearchProject" parameterType="SysResearchProject" useGeneratedKeys="true" keyProperty="projectId">
        insert into sys_research_project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectName != null">project_name,</if>
            <if test="projectLeader != null">project_leader,</if>
            <if test="projectType != null">project_type,</if>
            <if test="approveTime != null">approve_time,</if>
            <if test="fundingAmount != null">funding_amount,</if>
            <if test="arrivalStatus != null">arrival_status,</if>
            <if test="attachmentUrl != null">attachment_url,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectName != null">#{projectName},</if>
            <if test="projectLeader != null">#{projectLeader},</if>
            <if test="projectType != null">#{projectType},</if>
            <if test="approveTime != null">#{approveTime},</if>
            <if test="fundingAmount != null">#{fundingAmount},</if>
            <if test="arrivalStatus != null">#{arrivalStatus},</if>
            <if test="attachmentUrl != null">#{attachmentUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysResearchProject" parameterType="SysResearchProject">
        update sys_research_project
        <set>
            <if test="projectName != null">project_name = #{projectName},</if>
            <if test="projectLeader != null">project_leader = #{projectLeader},</if>
            <if test="projectType != null">project_type = #{projectType},</if>
            <if test="approveTime != null">approve_time = #{approveTime},</if>
            <if test="fundingAmount != null">funding_amount = #{fundingAmount},</if>
            <if test="arrivalStatus != null">arrival_status = #{arrivalStatus},</if>
            <if test="attachmentUrl != null">attachment_url = #{attachmentUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where project_id = #{projectId}
    </update>

    <delete id="deleteSysResearchProjectByProjectId" parameterType="Long">
        delete from sys_research_project where project_id = #{projectId}
    </delete>

    <delete id="deleteSysResearchProjectByProjectIds" parameterType="Long[]">
        delete from sys_research_project where project_id in 
        <foreach item="projectId" collection="array" open="(" separator="," close=")">
            #{projectId}
        </foreach>
    </delete>
</mapper>
